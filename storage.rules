rules_version = '2';

// Media is uploaded and deleted by the Relay server through the Admin SDK.
// Browsers only read objects through Firebase download URLs, which carry their
// own access token, so direct client access stays closed.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
