# Relay API
PORT=4000
PUBLIC_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional: set a stable secret. If omitted, one is generated in server/data/.secret
# SESSION_SECRET=change-me

# Firebase (Firestore + Storage)
# Either point FIREBASE_SERVICE_ACCOUNT at a service-account JSON file, paste the
# JSON itself (single line), or provide the whole file as base64 (best for hosts
# that only accept single-line secrets). Defaults to
# server/data/firebase-service-account.json.
# FIREBASE_SERVICE_ACCOUNT=./data/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
FIREBASE_PROJECT_ID=relay-messenger-anasprm
FIREBASE_FIRESTORE_DATABASE=default

# Storage needs a Cloud Storage bucket. New buckets require the Blaze plan; while
# billing is disabled, leave this unset and uploads fall back to server/uploads.
# FIREBASE_STORAGE_BUCKET=relay-messenger-anasprm.firebasestorage.app
